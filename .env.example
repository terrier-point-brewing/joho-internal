# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and anon key — exposed to the browser via Next.js static analysis.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-side only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Square ────────────────────────────────────────────────────────────────────
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Webhook (order.* events → auto-sync finance transactions + taproom consumption).
# SQUARE_WEBHOOK_SIGNATURE_KEY: the signature key from the Square dashboard webhook.
# SQUARE_WEBHOOK_URL: the exact notification URL configured in Square — it is part
# of the signed payload, so it must match character-for-character (e.g.
# https://tpb-square-reports.vercel.app/api/webhooks/square).
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=

# ── Ramp ──────────────────────────────────────────────────────────────────────
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=

# ── Plaid ─────────────────────────────────────────────────────────────────────
# Bank balance feed for GL 1020 Chase Operating. App-level credentials only —
# the per-bank access_token is minted at link time and stored in
# integration_connections.credentials, never in env.
# From dashboard.plaid.com > Developers > Keys. The free Trial plan is enough:
# it carries real production data, includes Balance + Transactions and Chase
# over OAuth, and allows 10 Items (we use one).
PLAID_CLIENT_ID=
PLAID_SECRET=
# "production" (Trial plans run here too) or "sandbox". Defaults to production.
PLAID_ENV=production
# Required for OAuth banks such as Chase. Must match a URI registered under
# Developers > API > Allowed redirect URIs CHARACTER FOR CHARACTER — no trailing
# slash, no query string. Plaid requires https in production; http://localhost is
# accepted only in Sandbox, so the real Chase link has to be done on the deployed
# app rather than locally.
#   production: https://internal.johobrewing.com/settings/finance/bank-connections
#   sandbox:    http://localhost:3000/settings/finance/bank-connections
PLAID_REDIRECT_URI=https://internal.johobrewing.com/settings/finance/bank-connections

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Optional — email sending is silently skipped when unset.
RESEND_API_KEY=

# ── Cron ──────────────────────────────────────────────────────────────────────
# Required for Vercel cron job authentication. Generate with: openssl rand -hex 32
CRON_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
# Absolute base URL used when constructing links in emails.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_APP_URL=https://internal.johobrewing.com
