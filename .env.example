# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and anon key — exposed to the browser via Next.js static analysis.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-side only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Square ────────────────────────────────────────────────────────────────────
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Webhook (order.* events → auto-sync finance transactions + taproom consumption).
# SQUARE_WEBHOOK_SIGNATURE_KEY: the signature key from the Square dashboard webhook.
# SQUARE_WEBHOOK_URL: the exact notification URL configured in Square — it is part
# of the signed payload, so it must match character-for-character (e.g.
# https://tpb-square-reports.vercel.app/api/webhooks/square).
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=

# ── Ramp ──────────────────────────────────────────────────────────────────────
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Optional — email sending is silently skipped when unset.
RESEND_API_KEY=

# ── Cron ──────────────────────────────────────────────────────────────────────
# Required for Vercel cron job authentication. Generate with: openssl rand -hex 32
CRON_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
# Absolute base URL used when constructing links in emails.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_APP_URL=https://app.terrierpoint.com
